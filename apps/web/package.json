{
  "name": "@ecole-saas/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm --filter=@ecole-saas/shared build",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pretype-check": "pnpm --filter=@ecole-saas/shared build",
    "type-check": "tsc --noEmit",
    "pretest": "pnpm --filter=@ecole-saas/shared build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "clean": "rm -rf .next .turbo node_modules playwright-report test-results"
  },
  "dependencies": {
    "@ecole-saas/shared": "workspace:*",
    "@hookform/resolvers": "^3.9.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^10.53.1",
    "@tanstack/react-query": "^5.56.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "motion": "^12",
    "next": "^14.2.15",
    "next-intl": "^4.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@ecole-saas/typescript-config": "workspace:*",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
