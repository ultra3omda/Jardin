{
  "name": "@klasso/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:prod": "eas build --profile production --platform all",
    "eas:submit:prod": "eas submit --profile production --platform all",
    "type-check": "tsc --noEmit",
    "lint": "echo \"Mobile lint deferred to V12 (EAS Build setup)\"",
    "test": "jest"
  },
  "dependencies": {
    "@ecole-saas/shared": "workspace:*",
    "@klasso/ui-mobile": "workspace:*",
    "@expo/vector-icons": "^15.0.3",
