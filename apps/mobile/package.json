    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
