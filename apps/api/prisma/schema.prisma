// Prisma schema for Ecole SaaS multi-tenant API
// IDs are cuid2 (generated in code via @paralleldrive/cuid2) — Prisma's
// native @default(cuid()) is cuid v1, which CLAUDE.md explicitly forbids.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum TenantType {
  KINDERGARTEN
  PRIMARY_SCHOOL
  MIXED
}

enum Locale {
  fr
  en
  ar
  es
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STAFF
}

enum Sex {
  M
  F
}

// V3-A — Nature du lien parent ↔ élève. LEGAL_GUARDIAN couvre les tuteurs
// non-parents (oncle, grand-parent, ASE…). OTHER pour cas atypiques (famille
// d'accueil, contact d'urgence sans autorité parentale légale).
enum RelationType {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  OTHER
}

// ============================================================================
// Models
// ============================================================================

model Tenant {
  id        String     @id
  name      String
  slug      String     @unique
  type      TenantType
  locale    Locale     @default(fr)
  timezone  String     @default("Europe/Paris")
  brand     Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  users           User[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  students        Student[]
  parentRelations ParentStudent[] // V3-A
  conversations   Conversation[] // V3-B
  messages        Message[] // V3-B
  classes         Class[] // V4
  classTeachers   ClassTeacher[] // V4
  timeSlots       TimeSlot[] // V4
  subjects        Subject[] // V6
  gradePeriods    GradePeriod[] // V6
  evaluations     Evaluation[] // V6
  grades          Grade[] // V6
  bulletins       Bulletin[] // V6
  invoices        Invoice[] // V8
  notifications   Notification[] // V8
  announcements   Announcement[] // V9
  attendances     Attendance[] // V9

  @@index([slug])
  @@map("tenants")
}

model User {
  id                        String    @id
  tenantId                  String?
  email                     String
  passwordHash              String
  firstName                 String
  lastName                  String
  role                      UserRole
  locale                    Locale    @default(fr)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?
  lastLoginAt               DateTime?
  emailVerifiedAt           DateTime? // V1.5: null = not verified, date = verified
  passwordChangedAt         DateTime? // V1.5: set on password change to invalidate sessions
  // V10: push notifications
  expoPushToken             String?
  pushEnabled               Boolean   @default(true)
  emailNotificationsEnabled Boolean   @default(true)

  tenant                     Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  createdInviteTokens        InviteToken[]             @relation("InviteTokenCreator")
  parentRelations            ParentStudent[]           @relation("ParentRelations") // V3-A: only when role = PARENT
  conversationParticipations ConversationParticipant[] // V3-B
  sentMessages               Message[]                 @relation("MessageSender") // V3-B
  classAssignments           ClassTeacher[]            @relation("TeacherAssignments") // V4
  timeSlotAssignments        TimeSlot[]                @relation("SlotTeacher") // V4
  evaluationsCreated         Evaluation[]              @relation("EvaluationsCreated") // V6
  bulletinsGenerated         Bulletin[]                @relation("BulletinsGenerated") // V6
  notifications              Notification[] // V8
  announcementsAuthored      Announcement[]            @relation("AnnouncementsAuthored") // V9
  attendanceRecorded         Attendance[]              @relation("AttendanceRecorded") // V9

  @@unique([tenantId, email], name: "email_per_tenant")
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id                String    @id
  tenantId          String? // V1.5: nullable to support SUPER_ADMIN (cross-tenant)
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  ip                String?
  userAgent         String?

  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenChain", fields: [replacedByTokenId], references: [id])
  replaces        RefreshToken? @relation("RefreshTokenChain")

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id
  tenantId  String?
  userId    String?
  action    String
  resource  String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@index([action, createdAt]) // V1.5: for RGPD query "all login.success in 2026"
  @@map("audit_logs")
}

// ============================================================================
// V1.5 — Recovery & Invite-only
// ============================================================================

model EmailVerificationToken {
  id         String    @id
  userId     String
  tokenHash  String    @unique // SHA-256 of the token sent in the verification email
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id
  userId     String
  tokenHash  String    @unique // SHA-256 of the token sent in the reset email
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model InviteToken {
  id               String    @id
  tokenHash        String    @unique // SHA-256 of the token shared with the invitee
  invitedEmail     String? // optional pre-fill for /register?token=...
  intendedRole     UserRole // SCHOOL_ADMIN for tenant creators (default)
  createdById      String // super_admin user who emitted the token
  consumedByUserId String? // user created by consuming this token
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  createdBy User @relation("InviteTokenCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("invite_tokens")
}

// ============================================================================
// V2 — Module Élèves
// ============================================================================

model Student {
  id       String @id // cuid2 (cohérent avec User, Tenant)
  tenantId String

  // — Identité —
  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  sex         Sex
  nationality String? // ISO 3166-1 alpha-2 (ex: 'TN', 'FR', 'DZ')

  // — Scolarité —
  classroom         String // V2: string libre (ex: "CP-A"). V4: relation Class
  enrollmentDate    DateTime @default(now()) @db.Date
  previousSchooling String?  @db.Text

  // — Famille —
  parentEmail   String // V2: string ref. V3: relation Parent N-N
  siblingsCount Int    @default(0)

  // — Contact —
  addressLine String?
  city        String?
  postalCode  String?
  country     String? @default("TN")

  // — Langue —
  motherTongue String? // ISO 639-1 (ex: 'ar', 'fr', 'en')

  // — Santé (light V2, médical strict V8) —
  medicalNotes String? @db.Text // warning RGPD côté UI (cf. R4 spec)

  // — Photo —
  photoUrl String? // R2 public URL

  // — Méta —
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  parentRelations ParentStudent[]
  grades          Grade[] // V6
  bulletins       Bulletin[] // V6
  invoices        Invoice[] // V8
  attendances     Attendance[] // V9

  @@index([tenantId, lastName])
  @@index([tenantId, classroom])
  @@index([tenantId, parentEmail])
  @@map("students")
}

// V3-A — Lien parent ↔ élève (N-N) via User(role=PARENT). Pivot table.
// Enforce 1 lien par (parent,élève) au niveau DB. isPrimaryContact reste flag
// applicatif (un par élève côté UX, non-enforced DB pour permettre transitions).
model ParentStudent {
  id               String       @id // cuid2
  tenantId         String
  parentUserId     String
  studentId        String
  relationType     RelationType
  isPrimaryContact Boolean      @default(false)
  createdAt        DateTime     @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent  User    @relation("ParentRelations", fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId], name: "unique_parent_student")
  @@index([tenantId])
  @@index([studentId])
  @@index([parentUserId])
  @@map("parent_students")
}

// V3-B — Conversation 1:1 entre deux User d'un même tenant. Multi-party (groupes)
// reporté V9 (notifications + canaux). Pour l'instant : strictly 2 participants,
// enforced applicatif lors de la création (pas de contrainte DB).
model Conversation {
  id        String   @id // cuid2
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([tenantId])
  @@map("conversations")
}

// V3-B — Pivot participant. lastReadAt tracks unread badge per user.
model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

// V3-B — Message texte. Plain text V3-B, attachments reportés V9. readAt
// nullable = unread state. tenantId duplicated for isolation queries (sans
// double join via Conversation).
model Message {
  id             String    @id // cuid2
  tenantId       String
  conversationId String
  senderId       String
  body           String    @db.Text
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@index([senderId])
  @@map("messages")
}

// V4 — Classe scolaire (eg "CP-A", "6e-Bleue"). schoolYear ISO ("2025-2026").
// La string `classroom` actuelle sur Student reste pour migration progressive ;
// `classId` FK est ajouté plus tard quand on aura le bulk-assign.
model Class {
  id         String    @id // cuid2
  tenantId   String
  name       String // ex. "CP-A"
  level      String // ex. "CP", "CE1", "6e"
  schoolYear String // ex. "2025-2026"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // soft-delete

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teachers    ClassTeacher[]
  timeSlots   TimeSlot[]
  evaluations Evaluation[] // V6
  attendances Attendance[] // V9

  @@unique([tenantId, schoolYear, name], name: "unique_class_per_year")
  @@index([tenantId, schoolYear])
  @@map("classes")
}

// V4 — Pivot enseignant ↔ classe. Plusieurs profs par classe (un par matière
// au primaire pas pertinent — un seul prof "main"; au collège/lycée — N profs).
// `isMainTeacher` distingue le professeur principal (un par classe côté UX).
model ClassTeacher {
  id            String   @id // cuid2
  tenantId      String
  classId       String
  teacherUserId String
  subject       String // matière enseignée
  isMainTeacher Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User   @relation("TeacherAssignments", fields: [teacherUserId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherUserId, subject], name: "unique_assignment")
  @@index([tenantId])
  @@index([classId])
  @@index([teacherUserId])
  @@map("class_teachers")
}

// V4 — Créneau EDT hebdomadaire récurrent (D31). dayOfWeek 1=Lundi..7=Dimanche
// (ISO-8601). periodStart/End "HH:MM" 24h. teacherUserId nullable pour les
// créneaux non encore assignés (planification provisionnelle).
model TimeSlot {
  id            String   @id // cuid2
  tenantId      String
  classId       String
  dayOfWeek     Int // 1..7 (ISO Lundi..Dimanche)
  periodStart   String // "HH:MM" (24h)
  periodEnd     String // "HH:MM"
  subject       String
  teacherUserId String? // nullable: créneau planifié sans prof
  room          String? // ex. "Salle 12"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User?  @relation("SlotTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([classId, dayOfWeek])
  @@index([teacherUserId])
  @@map("time_slots")
}

// ============================================================================
// V6 — Pédagogie + Bulletins
// ============================================================================

// V6 — Matière scolaire (ex. "Mathématiques", "Français"). Tenant-scoped.
// Indépendante du legacy string `subject` sur ClassTeacher/TimeSlot (FK V6-B).
model Subject {
  id          String    @id // cuid2
  tenantId    String
  name        String
  code        String? // ex. "MATH", "FR"
  emoji       String? // optional emoji icon e.g. "📐"
  coefficient Float     @default(1) // grade weight 1-10
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft-delete

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]

  @@unique([tenantId, name], name: "unique_subject_per_tenant")
  @@index([tenantId])
  @@map("subjects")
}

// V6 — Période de notation (trimestre / semestre). `isClosed` lock l'édition
// des notes (mais pas la regénération du bulletin).
model GradePeriod {
  id         String   @id // cuid2
  tenantId   String
  name       String // ex. "T1", "Semestre 1"
  schoolYear String // ex. "2025-2026"
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]
  bulletins   Bulletin[]

  @@unique([tenantId, schoolYear, name], name: "unique_period_per_year")
  @@index([tenantId, schoolYear])
  @@map("grade_periods")
}

// V6 — Évaluation (devoir / contrôle / composition) d'une classe + matière
// dans une période. `maxScore` = barème (ex. 20, 100). Pas de coefficient V6.
model Evaluation {
  id            String   @id // cuid2
  tenantId      String
  classId       String
  subjectId     String
  gradePeriodId String
  title         String // ex. "Contrôle chap. 3"
  date          DateTime @db.Date
  maxScore      Float // barème (ex. 20.0, 100.0)
  createdById   String // user (TEACHER or SCHOOL_ADMIN) who created it
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class       Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradePeriod GradePeriod @relation(fields: [gradePeriodId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("EvaluationsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  grades      Grade[]

  @@index([tenantId])
  @@index([classId, gradePeriodId])
  @@index([subjectId])
  @@map("evaluations")
}

// V6 — Note d'un élève sur une évaluation. Unique (evaluationId, studentId).
// `score` ∈ [0, evaluation.maxScore] (validation applicatif).
model Grade {
  id           String   @id // cuid2
  tenantId     String
  evaluationId String
  studentId    String
  score        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, studentId], name: "unique_grade_per_eval_student")
  @@index([tenantId])
  @@index([studentId])
  @@map("grades")
}

// V6 — Bulletin généré pour un (élève, période). `data` = snapshot Json des
// moyennes calculées au moment de la génération (idempotent pour re-print).
// Unique (studentId, gradePeriodId): un seul bulletin actif par couple.
model Bulletin {
  id            String   @id // cuid2
  tenantId      String
  studentId     String
  gradePeriodId String
  data          Json // snapshot complet (subjects, averages, overall)
  pdfUrl        String? // R2 URL — optional V6, surtout V6-B
  generatedById String
  generatedAt   DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradePeriod GradePeriod @relation(fields: [gradePeriodId], references: [id], onDelete: Restrict)
  generatedBy User        @relation("BulletinsGenerated", fields: [generatedById], references: [id], onDelete: Cascade)

  @@unique([studentId, gradePeriodId], name: "unique_bulletin_per_student_period")
  @@index([tenantId])
  @@index([gradePeriodId])
  @@map("bulletins")
}

// ============================================================================
// V8 — Finance
// ============================================================================

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id        String        @id @default(cuid())
  tenantId  String
  studentId String?
  title     String
  amount    Decimal       @db.Decimal(10, 3)
  currency  String        @default("TND")
  status    InvoiceStatus @default(PENDING)
  dueDate   DateTime
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  label     String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 3)
  amount    Decimal @db.Decimal(10, 3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(10, 3)
  method    String // "cash" | "bank_transfer" | "stripe" | "konnect"
  reference String?
  notes     String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ============================================================================
// V8 — Notifications
// ============================================================================

enum NotificationType {
  MESSAGE
  GRADE
  ATTENDANCE
  INVOICE
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([readAt])
}

// ============================================================================
// V9 — Announcements + Attendance
// ============================================================================

enum AnnouncementAudience {
  ALL
  PARENTS
  TEACHERS
  STAFF
}

model Announcement {
  id        String               @id
  tenantId  String
  title     String               @db.VarChar(200)
  body      String               @db.Text
  audience  AnnouncementAudience @default(ALL)
  authorId  String
  publishAt DateTime             @default(now())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation("AnnouncementsAuthored", fields: [authorId], references: [id])

  @@index([tenantId])
  @@index([tenantId, publishAt])
  @@map("announcements")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id           String           @id
  tenantId     String
  studentId    String
  classId      String?
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  notes        String?          @db.VarChar(500)
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  recordedBy User    @relation("AttendanceRecorded", fields: [recordedById], references: [id])

  @@unique([tenantId, studentId, date], name: "unique_attendance_per_day")
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, classId, date])
  @@map("attendance")
}
