// Prisma schema for Ecole SaaS multi-tenant API
// IDs are cuid2 (generated in code via @paralleldrive/cuid2) — Prisma's
// native @default(cuid()) is cuid v1, which CLAUDE.md explicitly forbids.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum TenantType {
  KINDERGARTEN
  PRIMARY_SCHOOL
  MIXED
}

enum Locale {
  fr
  en
  ar
  es
}

enum UserRole {
  SUPER_ADMIN
  COMMERCIAL // GTM — sous-admin plateforme : signe les contrats & crée les organisations (tenantId = null)
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STAFF
}

// GTM — Cycle de vie d'une organisation depuis la signature jusqu'à l'usage.
// PENDING_ONBOARDING : org créée par le commercial, admin pas encore passé par
// le wizard de personnalisation (nom + couleurs + logo). ACTIVE : onboarding
// terminé, l'org peut utiliser l'application. SUSPENDED : accès coupé (impayé…).
enum TenantStatus {
  PENDING_ONBOARDING
  ACTIVE
  SUSPENDED
}

enum Sex {
  M
  F
}

// V3-A — Nature du lien parent ↔ élève. LEGAL_GUARDIAN couvre les tuteurs
// non-parents (oncle, grand-parent, ASE…). OTHER pour cas atypiques (famille
// d'accueil, contact d'urgence sans autorité parentale légale).
enum RelationType {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  OTHER
}

// T2b — Humeur de l'enfant consignée dans le journal quotidien.
enum ChildMood {
  HAPPY
  CALM
  TIRED
  UPSET
  SICK
}

// T2b — Catégorie d'activité (atelier, sortie…).
enum ActivityCategory {
  ART
  MUSIC
  SPORT
  OUTING
  OTHER
}

// Devoirs — statut de rendu d'un élève (suivi par l'enseignant).
enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
}

// ============================================================================
// Models
// ============================================================================

model Tenant {
  id                    String       @id
  name                  String
  slug                  String       @unique
  type                  TenantType
  locale                Locale       @default(fr)
  timezone              String       @default("Europe/Paris")
  brand                 Json?
  // GTM — Onboarding bloquant : tant que onboardingCompletedAt est null, l'admin
  // de l'org est redirigé de force vers le wizard de personnalisation.
  status                TenantStatus @default(PENDING_ONBOARDING)
  onboardingCompletedAt DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  users           User[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  students        Student[]
  parentRelations ParentStudent[] // V3-A
  conversations   Conversation[] // V3-B
  messages        Message[] // V3-B
  classes         Class[] // V4
  classTeachers   ClassTeacher[] // V4
  timeSlots       TimeSlot[] // V4
  subjects        Subject[] // V6
  gradePeriods    GradePeriod[] // V6
  evaluations     Evaluation[] // V6
  grades          Grade[] // V6
  bulletins       Bulletin[] // V6
  invoices        Invoice[] // V8
  feeAssignments  FeeAssignment[] // G2 — referentiel de frais
  notifications   Notification[] // V8
  announcements   Announcement[] // V9
  attendances     Attendance[] // V9

  // T2b — Journal & Activities
  dailyLogEntries        DailyLogEntry[]
  activities             Activity[]
  activityParticipations ActivityParticipation[]

  // T2b PR-2 — Discipline & Santé
  disciplineIncidents DisciplineIncident[]
  healthRecords       HealthRecord[]
  infirmaryVisits     InfirmaryVisit[]
  vaccinations        Vaccination[]

  // T2b PR-3 — Cantine & Transport
  canteenMenus         CanteenMenu[]
  mealPlans            MealPlan[]
  busRoutes            BusRoute[]
  busStops             BusStop[]
  transportAssignments TransportAssignment[]

  // T2b PR-4 — Sécurité
  securityIncidents SecurityIncident[]
  visitorLogs       VisitorLog[]
  safetyDrills      SafetyDrill[]

  // T2c V1 — RH / Paie
  employmentContracts EmploymentContract[]
  leaveRequests       LeaveRequest[] // T2c V2
  payslips            Payslip[] // T2c V3
  payslipComponents   PayslipComponent[] // T2c V3

  // GTM — Abonnements & paiements (ClicToPay)
  subscriptions       TenantSubscription[]
  paymentTransactions PaymentTransaction[]

  homeworks           Homework[]
  homeworkSubmissions HomeworkSubmission[]

  // GTM — Contrats signés rattachés par le commercial
  contracts    Contract[]
  inviteTokens InviteToken[]

  // affectations — matières enseignées (périmètre prof)
  teacherSubjects TeacherSubject[]

  // G2 — referentiel de frais & SMS log
  feeTypes        FeeType[]
  feeInstallments FeeInstallment[]
  smsLogs         SmsLog[]

  // G1 — caisse, dépenses, fournisseurs
  cashSessions  CashRegisterSession[]
  cashMovements CashMovement[]
  suppliers     Supplier[]
  expenses      Expense[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model User {
  id                        String    @id
  tenantId                  String?
  email                     String
  passwordHash              String
  firstName                 String
  lastName                  String
  // Contact phone — collected on parent-account creation (mobile makes it
  // mandatory in the form; nullable here for pre-existing rows & other roles).
  phone                     String?   @db.VarChar(40)
  role                      UserRole
  locale                    Locale    @default(fr)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?
  lastLoginAt               DateTime?
  emailVerifiedAt           DateTime? // V1.5: null = not verified, date = verified
  passwordChangedAt         DateTime? // V1.5: set on password change to invalidate sessions
  // V10: push notifications
  expoPushToken             String?
  pushEnabled               Boolean   @default(true)
  emailNotificationsEnabled Boolean   @default(true)

  tenant                     Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  createdInviteTokens        InviteToken[]             @relation("InviteTokenCreator")
  parentRelations            ParentStudent[]           @relation("ParentRelations") // V3-A: only when role = PARENT
  conversationParticipations ConversationParticipant[] // V3-B
  sentMessages               Message[]                 @relation("MessageSender") // V3-B
  classAssignments           ClassTeacher[]            @relation("TeacherAssignments") // V4
  timeSlotAssignments        TimeSlot[]                @relation("SlotTeacher") // V4
  evaluationsCreated         Evaluation[]              @relation("EvaluationsCreated") // V6
  bulletinsGenerated         Bulletin[]                @relation("BulletinsGenerated") // V6
  notifications              Notification[] // V8
  announcementsAuthored      Announcement[]            @relation("AnnouncementsAuthored") // V9
  attendanceRecorded         Attendance[]              @relation("AttendanceRecorded") // V9
  dailyLogsAuthored          DailyLogEntry[]           @relation("DailyLogsAuthored") // T2b
  disciplineReported         DisciplineIncident[]      @relation("DisciplineReported") // T2b PR-2
  disciplineResolved         DisciplineIncident[]      @relation("DisciplineResolved") // T2b PR-2
  healthRecordsUpdated       HealthRecord[]            @relation("HealthRecordsUpdated") // T2b PR-2
  infirmaryVisitsRecorded    InfirmaryVisit[]          @relation("InfirmaryVisitsRecorded") // T2b PR-2
  vaccinationsRecorded       Vaccination[]             @relation("VaccinationsRecorded") // T2b PR-2
  securityReported           SecurityIncident[]        @relation("SecurityReported") // T2b PR-4
  securityResolved           SecurityIncident[]        @relation("SecurityResolved") // T2b PR-4
  visitorLogsRecorded        VisitorLog[]              @relation("VisitorLogsRecorded") // T2b PR-4
  safetyDrillsRecorded       SafetyDrill[]             @relation("SafetyDrillsRecorded") // T2b PR-4
  employmentContracts        EmploymentContract[]      @relation("EmploymentContracts") // T2c V1
  leaveRequests              LeaveRequest[]            @relation("LeaveRequests") // T2c V2
  leaveReviews               LeaveRequest[]            @relation("LeaveReviews") // T2c V2
  payslips                   Payslip[]                 @relation("Payslips") // T2c V3
  activitiesResponsible      Activity[]                @relation("ActivityResponsible") // affectations: animateur d'activité
  teacherSubjects            TeacherSubject[]          @relation("TeacherSubjects") // affectations: matières enseignées
  homeworksCreated           Homework[]                @relation("HomeworkCreator") // devoirs créés

  @@unique([tenantId, email], name: "email_per_tenant")
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id                String    @id
  tenantId          String? // V1.5: nullable to support SUPER_ADMIN (cross-tenant)
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  ip                String?
  userAgent         String?

  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenChain", fields: [replacedByTokenId], references: [id])
  replaces        RefreshToken? @relation("RefreshTokenChain")

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id
  tenantId  String?
  userId    String?
  action    String
  resource  String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@index([action, createdAt]) // V1.5: for RGPD query "all login.success in 2026"
  @@map("audit_logs")
}

// ============================================================================
// V1.5 — Recovery & Invite-only
// ============================================================================

model EmailVerificationToken {
  id         String    @id
  userId     String
  tokenHash  String    @unique // SHA-256 of the token sent in the verification email
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id
  userId     String
  tokenHash  String    @unique // SHA-256 of the token sent in the reset email
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model InviteToken {
  id               String    @id
  tokenHash        String    @unique // SHA-256 of the token shared with the invitee
  invitedEmail     String? // optional pre-fill for /register?token=...
  intendedRole     UserRole // SCHOOL_ADMIN for tenant creators (default)
  // GTM — quand renseigné, l'invitation rattache l'admin à une organisation DÉJÀ
  // créée par le commercial (au lieu d'en créer une nouvelle au register).
  tenantId         String?
  createdById      String // super_admin / commercial user who emitted the token
  consumedByUserId String? // user created by consuming this token
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  createdBy User    @relation("InviteTokenCreator", fields: [createdById], references: [id], onDelete: Cascade)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([tenantId])
  @@map("invite_tokens")
}

// ============================================================================
// GTM — Contrats signés (uploadés par le commercial à la création d'une org)
// ============================================================================

model Contract {
  id          String    @id
  tenantId    String
  reference   String? // numéro de contrat / référence interne
  fileKey     String // clé R2 du PDF signé
  fileName    String // nom d'origine du fichier
  signedAt    DateTime // date de signature
  startDate   DateTime // début de l'engagement
  endDate     DateTime? // fin de l'engagement (null = indéterminée)
  notes       String?
  createdById String // commercial / super_admin qui a rattaché le contrat
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("contracts")
}

// ============================================================================
// V2 — Module Élèves
// ============================================================================

model Student {
  id       String @id // cuid2 (cohérent avec User, Tenant)
  tenantId String

  // — Identité —
  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  sex         Sex
  nationality String? // ISO 3166-1 alpha-2 (ex: 'TN', 'FR', 'DZ')

  // — Scolarité —
  classroom         String // V2: string libre (ex: "CP-A"). Conservé & synchronisé avec `class.name`.
  classId           String? // Lot 3: FK vers Class (source de vérité). Nullable pour élèves non assignés / classe legacy non résolue.
  enrollmentDate    DateTime @default(now()) @db.Date
  previousSchooling String?  @db.Text

  // — Famille —
  parentEmail   String // V2: string ref. V3: relation Parent N-N
  siblingsCount Int    @default(0)

  // — Contact —
  addressLine String?
  city        String?
  postalCode  String?
  country     String? @default("TN")

  // — Langue —
  motherTongue String? // ISO 639-1 (ex: 'ar', 'fr', 'en')

  // — Santé (light V2, médical strict V8) —
  medicalNotes String? @db.Text // warning RGPD côté UI (cf. R4 spec)

  // — Photo —
  photoUrl String? // R2 public URL

  // — Méta —
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class  Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  parentRelations ParentStudent[]
  grades          Grade[] // V6
  bulletins       Bulletin[] // V6
  invoices        Invoice[] // V8
  feeAssignments  FeeAssignment[] // G2 — referentiel de frais
  attendances     Attendance[] // V9

  // T2b — Journal & Activities
  dailyLogEntries        DailyLogEntry[]
  activityParticipations ActivityParticipation[]

  // T2b PR-2 — Discipline & Santé
  disciplineIncidents DisciplineIncident[]
  healthRecords       HealthRecord[] // 1/student enforced by @@unique
  infirmaryVisits     InfirmaryVisit[]
  vaccinations        Vaccination[]

  // T2b PR-3 — Cantine & Transport
  mealPlans            MealPlan[] // 1/student via @@unique
  transportAssignments TransportAssignment[]
  homeworkSubmissions  HomeworkSubmission[]

  @@index([tenantId, lastName])
  @@index([tenantId, classroom])
  @@index([tenantId, classId])
  @@index([tenantId, parentEmail])
  @@map("students")
}

// V3-A — Lien parent ↔ élève (N-N) via User(role=PARENT). Pivot table.
// Enforce 1 lien par (parent,élève) au niveau DB. isPrimaryContact reste flag
// applicatif (un par élève côté UX, non-enforced DB pour permettre transitions).
model ParentStudent {
  id               String       @id // cuid2
  tenantId         String
  parentUserId     String
  studentId        String
  relationType     RelationType
  isPrimaryContact Boolean      @default(false)
  createdAt        DateTime     @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent  User    @relation("ParentRelations", fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId], name: "unique_parent_student")
  @@index([tenantId])
  @@index([studentId])
  @@index([parentUserId])
  @@map("parent_students")
}

// V3-B — Conversation 1:1 entre deux User d'un même tenant. Multi-party (groupes)
// reporté V9 (notifications + canaux). Pour l'instant : strictly 2 participants,
// enforced applicatif lors de la création (pas de contrainte DB).
model Conversation {
  id        String   @id // cuid2
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([tenantId])
  @@map("conversations")
}

// V3-B — Pivot participant. lastReadAt tracks unread badge per user.
model ConversationParticipant {
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

// V3-B — Message texte. Plain text V3-B, attachments reportés V9. readAt
// nullable = unread state. tenantId duplicated for isolation queries (sans
// double join via Conversation).
model Message {
  id             String    @id // cuid2
  tenantId       String
  conversationId String
  senderId       String
  body           String    @db.Text
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@index([senderId])
  @@map("messages")
}

// V4 — Classe scolaire (eg "CP-A", "6e-Bleue"). schoolYear ISO ("2025-2026").
// La string `classroom` actuelle sur Student reste pour migration progressive ;
// `classId` FK est ajouté plus tard quand on aura le bulk-assign.
model Class {
  id         String    @id // cuid2
  tenantId   String
  name       String // ex. "CP-A"
  level      String // ex. "CP", "CE1", "6e"
  schoolYear String // ex. "2025-2026"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime? // soft-delete

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students    Student[] // Lot 3: élèves rattachés à cette classe (FK)
  teachers    ClassTeacher[]
  timeSlots   TimeSlot[]
  evaluations Evaluation[] // V6
  attendances Attendance[] // V9

  disciplineIncidents DisciplineIncident[] // T2b PR-2
  homeworks           Homework[]
  activities          Activity[]

  @@unique([tenantId, schoolYear, name], name: "unique_class_per_year")
  @@index([tenantId, schoolYear])
  @@map("classes")
}

// V4 — Pivot enseignant ↔ classe. Plusieurs profs par classe (un par matière
// au primaire pas pertinent — un seul prof "main"; au collège/lycée — N profs).
// `isMainTeacher` distingue le professeur principal (un par classe côté UX).
model ClassTeacher {
  id            String   @id // cuid2
  tenantId      String
  classId       String
  teacherUserId String
  subject       String // matière enseignée
  isMainTeacher Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User   @relation("TeacherAssignments", fields: [teacherUserId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherUserId, subject], name: "unique_assignment")
  @@index([tenantId])
  @@index([classId])
  @@index([teacherUserId])
  @@map("class_teachers")
}

// V4 — Créneau EDT hebdomadaire récurrent (D31). dayOfWeek 1=Lundi..7=Dimanche
// (ISO-8601). periodStart/End "HH:MM" 24h. teacherUserId nullable pour les
// créneaux non encore assignés (planification provisionnelle).
model TimeSlot {
  id            String   @id // cuid2
  tenantId      String
  classId       String
  dayOfWeek     Int // 1..7 (ISO Lundi..Dimanche)
  periodStart   String // "HH:MM" (24h)
  periodEnd     String // "HH:MM"
  subject       String
  teacherUserId String? // nullable: créneau planifié sans prof
  room          String? // ex. "Salle 12"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User?  @relation("SlotTeacher", fields: [teacherUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([classId, dayOfWeek])
  @@index([teacherUserId])
  @@map("time_slots")
}

// ============================================================================
// V6 — Pédagogie + Bulletins
// ============================================================================

// V6 — Matière scolaire (ex. "Mathématiques", "Français"). Tenant-scoped.
// Indépendante du legacy string `subject` sur ClassTeacher/TimeSlot (FK V6-B).
model Subject {
  id          String    @id // cuid2
  tenantId    String
  name        String
  code        String? // ex. "MATH", "FR"
  emoji       String? // optional emoji icon e.g. "📐"
  coefficient Float     @default(1) // grade weight 1-10
  levels      String[]  @default([]) // Lot 3: niveaux où la matière s'applique (ex. ["CP","CE1"]). Vide = tous niveaux.
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft-delete

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]
  teachers    TeacherSubject[] @relation("SubjectTeachers")
  homeworks   Homework[]

  @@unique([tenantId, name], name: "unique_subject_per_tenant")
  @@index([tenantId])
  @@map("subjects")
}

// V6 — Période de notation (trimestre / semestre). `isClosed` lock l'édition
// des notes (mais pas la regénération du bulletin).
model GradePeriod {
  id         String   @id // cuid2
  tenantId   String
  name       String // ex. "T1", "Semestre 1"
  schoolYear String // ex. "2025-2026"
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluations Evaluation[]
  bulletins   Bulletin[]

  @@unique([tenantId, schoolYear, name], name: "unique_period_per_year")
  @@index([tenantId, schoolYear])
  @@map("grade_periods")
}

// V6 — Évaluation (devoir / contrôle / composition) d'une classe + matière
// dans une période. `maxScore` = barème (ex. 20, 100). Pas de coefficient V6.
model Evaluation {
  id            String   @id // cuid2
  tenantId      String
  classId       String
  subjectId     String
  gradePeriodId String
  title         String // ex. "Contrôle chap. 3"
  date          DateTime @db.Date
  maxScore      Float // barème (ex. 20.0, 100.0)
  createdById   String // user (TEACHER or SCHOOL_ADMIN) who created it
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class       Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject     @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  gradePeriod GradePeriod @relation(fields: [gradePeriodId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("EvaluationsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  grades      Grade[]

  @@index([tenantId])
  @@index([classId, gradePeriodId])
  @@index([subjectId])
  @@map("evaluations")
}

// V6 — Note d'un élève sur une évaluation. Unique (evaluationId, studentId).
// `score` ∈ [0, evaluation.maxScore] (validation applicatif).
model Grade {
  id           String   @id // cuid2
  tenantId     String
  evaluationId String
  studentId    String
  score        Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, studentId], name: "unique_grade_per_eval_student")
  @@index([tenantId])
  @@index([studentId])
  @@map("grades")
}

// Devoirs (TAF) — un enseignant crée un devoir pour une classe (consigne +
// échéance + pièce R2 optionnelle). Le suivi des rendus se fait par élève.
model Homework {
  id            String    @id // cuid2
  tenantId      String
  classId       String
  subjectId     String? // matière optionnelle
  createdById   String // enseignant (ou admin) auteur
  title         String
  instructions  String // consigne (texte)
  attachmentUrl String? // pièce jointe (URL publique R2)
  dueDate       DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class       Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdBy   User                 @relation("HomeworkCreator", fields: [createdById], references: [id], onDelete: Cascade)
  submissions HomeworkSubmission[]

  @@index([tenantId])
  @@index([classId, dueDate])
  @@map("homeworks")
}

// Rendu d'un devoir par un élève — statut suivi par l'enseignant.
model HomeworkSubmission {
  id            String           @id // cuid2
  tenantId      String
  homeworkId    String
  studentId     String
  status        SubmissionStatus @default(PENDING)
  submittedAt   DateTime?
  feedback      String? // mot du prof
  attachmentUrl String? // rendu fichier optionnel (R2)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId], name: "unique_submission_per_student")
  @@index([tenantId])
  @@index([studentId])
  @@map("homework_submissions")
}

// V6 — Bulletin généré pour un (élève, période). `data` = snapshot Json des
// moyennes calculées au moment de la génération (idempotent pour re-print).
// Unique (studentId, gradePeriodId): un seul bulletin actif par couple.
model Bulletin {
  id            String   @id // cuid2
  tenantId      String
  studentId     String
  gradePeriodId String
  data          Json // snapshot complet (subjects, averages, overall)
  pdfUrl        String? // R2 URL — optional V6, surtout V6-B
  generatedById String
  generatedAt   DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradePeriod GradePeriod @relation(fields: [gradePeriodId], references: [id], onDelete: Restrict)
  generatedBy User        @relation("BulletinsGenerated", fields: [generatedById], references: [id], onDelete: Cascade)

  @@unique([studentId, gradePeriodId], name: "unique_bulletin_per_student_period")
  @@index([tenantId])
  @@index([gradePeriodId])
  @@map("bulletins")
}

// ============================================================================
// V8 — Finance
// ============================================================================

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id        String        @id @default(cuid())
  tenantId  String
  studentId String?
  title     String
  amount    Decimal       @db.Decimal(10, 3)
  currency  String        @default("TND")
  status    InvoiceStatus @default(PENDING)
  dueDate   DateTime
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // G2 — referentiel de frais : rattachement optionnel + reconciliation import
  feeTypeId   String?
  externalRef String? // reconciliation import EducaKids

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@index([tenantId, externalRef])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  label     String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 3)
  amount    Decimal @db.Decimal(10, 3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Decimal  @db.Decimal(10, 3)
  method    String // "cash" | "bank_transfer" | "stripe" | "konnect"
  reference String?
  notes     String?
  paidAt    DateTime @default(now())

  // G1 — rattachement à la session de caisse ouverte (encaissement espèce)
  cashSessionId String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ============================================================================
// V8 — Notifications
// ============================================================================

enum NotificationType {
  MESSAGE
  GRADE
  ATTENDANCE
  INVOICE
  ANNOUNCEMENT
  SYSTEM
  PAYMENT_REMINDER // G2 — relance impayés
}

model Notification {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([readAt])
}

// ============================================================================
// V9 — Announcements + Attendance
// ============================================================================

enum AnnouncementAudience {
  ALL
  PARENTS
  TEACHERS
  STAFF
}

model Announcement {
  id        String               @id
  tenantId  String
  title     String               @db.VarChar(200)
  body      String               @db.Text
  audience  AnnouncementAudience @default(ALL)
  authorId  String
  publishAt DateTime             @default(now())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation("AnnouncementsAuthored", fields: [authorId], references: [id])

  @@index([tenantId])
  @@index([tenantId, publishAt])
  @@map("announcements")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id           String           @id
  tenantId     String
  studentId    String
  classId      String?
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  notes        String?          @db.VarChar(500)
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  recordedBy User    @relation("AttendanceRecorded", fields: [recordedById], references: [id])

  @@unique([tenantId, studentId, date], name: "unique_attendance_per_day")
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, classId, date])
  @@map("attendance")
}

// ============================================================================
// T2b — Journal quotidien + Activités
// ============================================================================

// T2b — Entrée de journal quotidien d'un élève (repas, sieste, humeur…).
// Un seul journal par (tenant, élève, jour) — enforce DB.
model DailyLogEntry {
  id             String     @id
  tenantId       String
  studentId      String
  date           DateTime   @db.Date
  meals          String?    @db.VarChar(200)
  nap            String?    @db.VarChar(200)
  mood           ChildMood?
  bathroom       String?    @db.VarChar(200)
  activitiesNote String?    @db.Text
  generalNote    String?    @db.Text
  photoUrl       String? // photo du jour (URL publique R2)
  authorId       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation("DailyLogsAuthored", fields: [authorId], references: [id])

  @@unique([tenantId, studentId, date], name: "unique_daily_log_per_day")
  @@index([tenantId, date])
  @@index([tenantId, studentId])
  @@map("daily_log_entries")
}

// T2b — Activité pédagogique (atelier, sortie). Participations N-N via pivot.
model Activity {
  id                String           @id
  tenantId          String
  name              String           @db.VarChar(160)
  description       String?          @db.Text
  category          ActivityCategory @default(OTHER)
  scheduledAt       DateTime?
  durationMin       Int?
  location          String?          @db.VarChar(160)
  // affectations: enseignant/animateur responsable de l'activité (optionnel).
  responsibleUserId String?
  // atelier rattaché à une classe → participants = présents du jour (optionnel).
  classId           String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  responsible    User?                   @relation("ActivityResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  class          Class?                  @relation(fields: [classId], references: [id], onDelete: SetNull)
  participations ActivityParticipation[]

  @@index([tenantId])
  @@index([responsibleUserId])
  @@map("activities")
}

// affectations — Matières enseignées par un enseignant (N:N User↔Subject).
// Distinct de ClassTeacher.subject (qui dit "ce prof enseigne cette matière
// DANS cette classe") : ici on déclare le périmètre de compétence du prof.
model TeacherSubject {
  id            String   @id
  tenantId      String
  teacherUserId String
  subjectId     String
  createdAt     DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher User    @relation("TeacherSubjects", fields: [teacherUserId], references: [id], onDelete: Cascade)
  subject Subject @relation("SubjectTeachers", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherUserId, subjectId])
  @@index([tenantId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

// T2b — Pivot élève ↔ activité. Unique (activity, student) — enforce DB.
model ActivityParticipation {
  id         String   @id
  tenantId   String
  activityId String
  studentId  String
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([activityId, studentId], name: "unique_participation")
  @@index([tenantId, activityId])
  @@map("activity_participations")
}

// ============================================================================
// T2b — Discipline + Santé (PII médicale → RGPD strict)
// ============================================================================

// T2b — Gravité d'un incident de discipline.
enum DisciplineSeverity {
  MINOR
  MAJOR
  SUSPENSION
}

// T2b — Statut de résolution (partagé discipline / sécurité). OPEN par défaut.
enum IncidentStatus {
  OPEN
  RESOLVED
}

// T2b — Issue d'un passage à l'infirmerie. SENT_HOME / EMERGENCY → notifie parents.
enum InfirmaryOutcome {
  RETURNED_TO_CLASS
  SENT_HOME
  REFERRED
  EMERGENCY
}

// T2b — Incident de discipline rattaché à un élève (classe optionnelle).
model DisciplineIncident {
  id             String             @id
  tenantId       String
  studentId      String
  classId        String?
  type           DisciplineSeverity
  occurredAt     DateTime           @db.Date
  description    String             @db.Text
  sanction       String?            @db.VarChar(500)
  status         IncidentStatus     @default(OPEN)
  resolutionNote String?            @db.Text
  resolvedAt     DateTime?
  reportedById   String
  resolvedById   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  reportedBy User    @relation("DisciplineReported", fields: [reportedById], references: [id])
  resolvedBy User?   @relation("DisciplineResolved", fields: [resolvedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
  @@map("discipline_incidents")
}

// T2b — Dossier de santé d'un élève (1 seul par élève, enforce DB).
model HealthRecord {
  id                    String    @id
  tenantId              String
  studentId             String
  bloodType             String?   @db.VarChar(8)
  allergies             String?   @db.Text
  chronicConditions     String?   @db.Text
  medications           String?   @db.Text
  dietaryRestrictions   String?   @db.Text
  doctorName            String?   @db.VarChar(160)
  doctorPhone           String?   @db.VarChar(40)
  emergencyContactName  String?   @db.VarChar(160)
  emergencyContactPhone String?   @db.VarChar(40)
  notes                 String?   @db.Text
  updatedById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy User    @relation("HealthRecordsUpdated", fields: [updatedById], references: [id])

  @@unique([tenantId, studentId], name: "unique_health_record_per_student")
  @@index([tenantId])
  @@map("health_records")
}

// T2b — Passage à l'infirmerie (journal des soins).
model InfirmaryVisit {
  id           String           @id
  tenantId     String
  studentId    String
  visitedAt    DateTime
  reason       String           @db.Text
  treatment    String?          @db.Text
  temperature  Float?
  outcome      InfirmaryOutcome @default(RETURNED_TO_CLASS)
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("InfirmaryVisitsRecorded", fields: [recordedById], references: [id])

  @@index([tenantId, studentId])
  @@index([tenantId, visitedAt])
  @@map("infirmary_visits")
}

// T2b — Vaccination consignée pour un élève.
model Vaccination {
  id             String    @id
  tenantId       String
  studentId      String
  vaccineName    String    @db.VarChar(120)
  administeredAt DateTime  @db.Date
  nextDueAt      DateTime? @db.Date
  notes          String?   @db.VarChar(500)
  recordedById   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("VaccinationsRecorded", fields: [recordedById], references: [id])

  @@index([tenantId, studentId])
  @@map("vaccinations")
}

// ============================================================================
// T2b — Cantine + Transport
// ============================================================================

enum MealRegime {
  STANDARD
  VEGETARIAN
  HALAL
  NO_PORK
  OTHER
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum TransportDirection {
  MORNING
  EVENING
  BOTH
}

// T2b — Menu de cantine du jour (niveau école, pas de lien élève).
model CanteenMenu {
  id         String    @id
  tenantId   String
  date       DateTime  @db.Date
  starter    String?   @db.VarChar(200)
  main       String?   @db.VarChar(200)
  dessert    String?   @db.VarChar(200)
  vegetarian String?   @db.VarChar(200)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date], name: "unique_canteen_menu_per_day")
  @@map("canteen_menus")
}

// T2b — Régime alimentaire d'un élève (1 seul par élève).
model MealPlan {
  id        String     @id
  tenantId  String
  studentId String
  regime    MealRegime @default(STANDARD)
  allergies String?    @db.Text
  active    Boolean    @default(true)
  notes     String?    @db.VarChar(500)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId], name: "unique_meal_plan_per_student")
  @@index([tenantId])
  @@map("meal_plans")
}

// T2b — Ligne de bus scolaire (niveau école) + arrêts + affectations.
model BusRoute {
  id            String      @id
  tenantId      String
  name          String      @db.VarChar(120)
  driverName    String?     @db.VarChar(160)
  driverPhone   String?     @db.VarChar(40)
  vehiclePlate  String?     @db.VarChar(20)
  departureTime String      @db.VarChar(5)
  returnTime    String?     @db.VarChar(5)
  status        RouteStatus @default(ACTIVE)
  capacity      Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stops       BusStop[]
  assignments TransportAssignment[]

  @@index([tenantId])
  @@map("bus_routes")
}

// T2b — Arrêt d'une ligne de bus.
model BusStop {
  id         String   @id
  tenantId   String
  routeId    String
  name       String   @db.VarChar(120)
  order      Int
  pickupTime String?  @db.VarChar(5)
  createdAt  DateTime @default(now())

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  route       BusRoute              @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments TransportAssignment[]

  @@index([tenantId, routeId])
  @@map("bus_stops")
}

// T2b — Affectation d'un élève à une ligne (et arrêt) pour une direction.
model TransportAssignment {
  id        String             @id
  tenantId  String
  studentId String
  routeId   String
  stopId    String?
  direction TransportDirection @default(BOTH)
  createdAt DateTime           @default(now())
  deletedAt DateTime?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    BusStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, routeId, direction], name: "unique_transport_assignment")
  @@index([tenantId, routeId])
  @@index([tenantId, studentId])
  @@map("transport_assignments")
}

// ============================================================================
// T2b — Sécurité (niveau école)
// ============================================================================

enum SecurityIncidentType {
  INTRUSION
  THEFT
  INJURY
  FIRE
  OTHER
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum DrillType {
  FIRE
  EARTHQUAKE
  LOCKDOWN
  OTHER
}

// T2b — Incident de sécurité (réutilise IncidentStatus de PR-2).
model SecurityIncident {
  id             String               @id
  tenantId       String
  type           SecurityIncidentType
  severity       SecuritySeverity     @default(LOW)
  location       String?              @db.VarChar(160)
  occurredAt     DateTime
  description    String               @db.Text
  status         IncidentStatus       @default(OPEN)
  resolutionNote String?              @db.Text
  resolvedAt     DateTime?
  reportedById   String
  resolvedById   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportedBy User   @relation("SecurityReported", fields: [reportedById], references: [id])
  resolvedBy User?  @relation("SecurityResolved", fields: [resolvedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("security_incidents")
}

// T2b — Journal des visiteurs.
model VisitorLog {
  id           String    @id
  tenantId     String
  visitorName  String    @db.VarChar(160)
  reason       String?   @db.VarChar(300)
  checkInAt    DateTime
  checkOutAt   DateTime?
  badgeNumber  String?   @db.VarChar(40)
  recordedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedBy User   @relation("VisitorLogsRecorded", fields: [recordedById], references: [id])

  @@index([tenantId, checkInAt])
  @@map("visitor_logs")
}

// T2b — Exercice de sécurité (incendie, confinement…).
model SafetyDrill {
  id           String    @id
  tenantId     String
  type         DrillType
  conductedAt  DateTime
  durationMin  Int?
  notes        String?   @db.Text
  recordedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recordedBy User   @relation("SafetyDrillsRecorded", fields: [recordedById], references: [id])

  @@index([tenantId, conductedAt])
  @@map("safety_drills")
}

// ============================================================================
// T2c V1 — RH / Paie : Contrats de travail
// ============================================================================

enum ContractType {
  CDI
  CDD
  VACATAIRE
  TEMPS_PARTIEL
}

enum ContractStatus {
  ACTIVE
  ENDED
}

// T2c V1 — Contrat de travail d'un employé (User TEACHER/STAFF).
// Montants en Decimal(10,3)/TND, aligné sur la finance V8. PII : jamais loggé.
model EmploymentContract {
  id          String         @id
  tenantId    String
  userId      String
  type        ContractType
  status      ContractStatus @default(ACTIVE)
  startDate   DateTime
  endDate     DateTime?
  baseSalary  Decimal        @db.Decimal(10, 3)
  currency    String         @default("TND")
  weeklyHours Int?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee User   @relation("EmploymentContracts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("employment_contracts")
}

// ============================================================================
// T2c V2 — RH / Paie : Demandes de congés
// ============================================================================

enum LeaveType {
  PAID
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// T2c V2 — Demande de congé d'un employé (User TEACHER/STAFF).
// Workflow PENDING → APPROVED/REJECTED par un SCHOOL_ADMIN (jamais ses propres congés).
model LeaveRequest {
  id           String      @id
  tenantId     String
  userId       String
  type         LeaveType
  status       LeaveStatus @default(PENDING)
  startDate    DateTime
  endDate      DateTime
  reason       String?     @db.Text
  reviewNote   String?     @db.Text
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   User   @relation("LeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?  @relation("LeaveReviews", fields: [reviewedById], references: [id])

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("leave_requests")
}

// ============================================================================
// T2c V3 — RH / Paie : Bulletins de paie
// ============================================================================

enum PayslipStatus {
  DRAFT
  ISSUED
}

enum PayslipComponentKind {
  EARNING
  DEDUCTION
}

// T2c V3 — Bulletin de paie d'un employé pour une période mensuelle ("YYYY-MM").
// Montants Decimal(10,3)/TND, alignés finance V8. PII : jamais loggé.
model Payslip {
  id              String        @id
  tenantId        String
  userId          String
  period          String        @db.VarChar(7)
  baseSalary      Decimal       @db.Decimal(10, 3)
  grossSalary     Decimal       @db.Decimal(10, 3)
  totalDeductions Decimal       @db.Decimal(10, 3)
  netSalary       Decimal       @db.Decimal(10, 3)
  currency        String        @default("TND")
  status          PayslipStatus @default(DRAFT)
  issuedAt        DateTime?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   User               @relation("Payslips", fields: [userId], references: [id], onDelete: Cascade)
  components PayslipComponent[]

  @@unique([tenantId, userId, period], name: "payslip_per_period")
  @@index([tenantId])
  @@index([tenantId, userId])
  @@map("payslips")
}

// T2c V3 — Ligne de gain/retenue d'un bulletin (composant de calcul).
model PayslipComponent {
  id        String               @id
  tenantId  String
  payslipId String
  label     String               @db.VarChar(160)
  kind      PayslipComponentKind
  amount    Decimal              @db.Decimal(10, 3)
  createdAt DateTime             @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, payslipId])
  @@map("payslip_components")
}

// ============================================================================
// GTM — Abonnements SaaS & paiements (ClicToPay / Monétique Tunisie)
// ============================================================================

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Catalogue de plans (global, non tenant-scoped). Prix en Decimal(10,3)/TND.
model SubscriptionPlan {
  id          String          @id
  code        String          @unique
  name        String          @db.VarChar(120)
  interval    BillingInterval @default(MONTHLY)
  price       Decimal         @db.Decimal(10, 3)
  currency    String          @default("TND")
  maxStudents Int?
  features    Json?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions TenantSubscription[]

  @@map("subscription_plans")
}

// Abonnement d'un établissement à un plan.
model TenantSubscription {
  id                 String             @id
  tenantId           String
  planId             String
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEnd           DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan     @relation(fields: [planId], references: [id])
  transactions PaymentTransaction[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tenant_subscriptions")
}

// Transaction de paiement ClicToPay. orderNumber = idempotence côté marchand,
// gatewayOrderId = mdOrder côté ClicToPay. Montants Decimal(10,3)/TND.
model PaymentTransaction {
  id             String        @id
  tenantId       String
  subscriptionId String?
  orderNumber    String        @unique
  gatewayOrderId String?
  amount         Decimal       @db.Decimal(10, 3)
  currency       String        @default("TND")
  status         PaymentStatus @default(PENDING)
  gatewayStatus  Int?
  rawPayload     Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription TenantSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("payment_transactions")
}

// ============================================================================
// G2 — Référentiel de frais & affectation (parité EducaKids)
// ============================================================================

enum FeeCategory {
  STANDARD
  DIVERS
  OPTIONNEL
}

enum FeeRecurrence {
  ONCE
  MONTHLY
  TERM
  YEARLY
}

enum FeeAssignmentStatus {
  DUE
  PARTIAL
  PAID
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
}

enum SmsStatus {
  SENT
  FAILED
  SKIPPED
}

model FeeType {
  id            String        @id // cuid2 (createId en service)
  tenantId      String
  name          String
  category      FeeCategory
  defaultAmount Decimal       @db.Decimal(10, 3)
  recurrence    FeeRecurrence @default(YEARLY)
  level         String? // niveau cible (3ans/4ans/prépa) ; null = tous
  schoolYear    String
  active        Boolean       @default(true)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments FeeAssignment[]

  @@index([tenantId, schoolYear, category])
  @@map("fee_types")
}

model FeeAssignment {
  id            String              @id // cuid2
  tenantId      String
  studentId     String
  feeTypeId     String
  schoolYear    String
  totalAmount   Decimal             @db.Decimal(10, 3)
  advanceAmount Decimal             @default(0) @db.Decimal(10, 3)
  status        FeeAssignmentStatus @default(DUE)
  externalRef   String? // reconciliation import
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeType      FeeType          @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  installments FeeInstallment[]

  @@unique([studentId, feeTypeId, schoolYear], name: "unique_fee_per_student_year")
  @@index([tenantId, status])
  @@map("fee_assignments")
}

model FeeInstallment {
  id           String            @id // cuid2
  tenantId     String
  assignmentId String
  label        String
  dueDate      DateTime          @db.Date
  amount       Decimal           @db.Decimal(10, 3)
  invoiceId    String?
  status       InstallmentStatus @default(PENDING)
  createdAt    DateTime          @default(now())

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignment FeeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueDate, status])
  @@map("fee_installments")
}

model SmsLog {
  id        String    @id // cuid2
  tenantId  String
  toMasked  String // n° masqué (4 derniers chiffres) — pas de PII complète
  body      String    @db.Text
  status    SmsStatus
  context   String? // ex. "payment_reminder"
  relatedId String? // id de l'entité source
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("sms_logs")
}

// ============================================================================
// G1 — Caisse, dépenses, fournisseurs (parité EducaKids)
// ============================================================================

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementKind {
  INCOME
  EXPENSE
}

model CashRegisterSession {
  id             String            @id // cuid2
  tenantId       String
  openedById     String
  openedAt       DateTime          @default(now())
  openingFloat   Decimal           @db.Decimal(10, 3)
  closedById     String?
  closedAt       DateTime?
  countedAmount  Decimal?          @db.Decimal(10, 3)
  expectedAmount Decimal?          @db.Decimal(10, 3)
  variance       Decimal?          @db.Decimal(10, 3)
  status         CashSessionStatus @default(OPEN)
  notes          String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movements CashMovement[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
  @@map("cash_register_sessions")
}

model CashMovement {
  id          String           @id // cuid2
  tenantId    String
  sessionId   String
  kind        CashMovementKind
  amount      Decimal          @db.Decimal(10, 3)
  label       String
  paymentId   String?
  expenseId   String?
  createdById String
  createdAt   DateTime         @default(now())

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@map("cash_movements")
}

model Supplier {
  id        String    @id // cuid2
  tenantId  String
  name      String
  phone     String?
  email     String?
  taxId     String? // matricule fiscal
  notes     String?   @db.Text
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([tenantId, name])
  @@map("suppliers")
}

model Expense {
  id           String    @id // cuid2
  tenantId     String
  supplierId   String?
  category     String
  amount       Decimal   @db.Decimal(10, 3)
  paidAt       DateTime  @db.Date
  method       String // "cash" | "cheque" | "bank_transfer"
  reference    String?
  notes        String?   @db.Text
  recordedById String
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId, paidAt])
  @@index([tenantId, category])
  @@map("expenses")
}
