{
  "name": "@ecole-saas/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS multi-tenant API for Ecole SaaS",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "prisma migrate deploy && node dist/main",
    "prebuild": "pnpm --filter=@ecole-saas/shared build",
    "build": "nest build",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings 0",
    "type-check": "tsc --noEmit",
    "pretest": "pnpm --filter=@ecole-saas/shared build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:cov": "pnpm --filter=@ecole-saas/shared build",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf dist .turbo node_modules coverage",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/s3-request-presigner": "^3.1052.0",
    "@ecole-saas/shared": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/websockets": "^11.1.24",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^5.20.0",
    "@react-email/components": "^0.0.34",
    "@react-email/render": "^1.1.2",
    "@react-pdf/renderer": "^4.0.0",
    "@sentry/nestjs": "^10.53.1",
    "@sentry/node": "^10.53.1",
    "archiver": "^7.0.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.0.0",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@ecole-saas/typescript-config": "workspace:*",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.2",
    "@nestjs/testing": "^10.4.4",
    "@swc/core": "^1.7.36",
    "@types/archiver": "^6.0.3",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "~18.3.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^2.1.2",
    "eslint": "^8.57.1",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.2"
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "tsconfig.json",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "plugin:@typescript-eslint/recommended"
    ],
    "root": true,
    "env": {
      "node": true
    },
    "ignorePatterns": [
      "dist/**",
      "node_modules/**",
      "coverage/**",
      "vitest.config.ts"
    ],
    "rules": {
      "@typescript-eslint/no-explicit-any": "error",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ],
      "@typescript-eslint/explicit-function-return-type": "off",
      "@typescript-eslint/explicit-module-boundary-types": "off",
      "@typescript-eslint/interface-name-prefix": "off"
    }
  }
}
