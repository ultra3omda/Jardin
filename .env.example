# =============================================================================
# Web (apps/web)
# =============================================================================
NEXT_PUBLIC_APP_NAME="Ecole SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# =============================================================================
# API (apps/api) — Vague 1
# =============================================================================
NODE_ENV="development"
API_PORT="4000"
CORS_ORIGIN="http://localhost:3000"

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecole_saas?schema=public"

# JWT secrets — generate locally via: openssl rand -base64 48
# MUST be at least 32 characters (>= 256 bits) — API refuses to start otherwise
JWT_ACCESS_SECRET="REPLACE_ME_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_VALUE"
JWT_REFRESH_SECRET="REPLACE_ME_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_VALUE"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Password hashing
BCRYPT_ROUNDS="12"

# =============================================================================
# API (apps/api) — Vague 1.5
# =============================================================================
# Absolute URL of the web app — used to build invite/verify/reset links in emails
WEB_APP_URL="http://localhost:3000"

# Resend API key (https://resend.com — free tier 3000 emails/mo)
# Get one from the Resend dashboard, then add to Railway + GitHub Actions secrets
RESEND_API_KEY="re_REPLACE_ME"

# Sender address. Use `onboarding@resend.dev` until a custom domain is verified.
EMAIL_FROM="onboarding@resend.dev"

# =============================================================================
# Mobile (apps/mobile) — Vague 2
# =============================================================================
# EXPO_PUBLIC_API_URL="http://localhost:4000"
