# =============================================================================
# Web (apps/web)
# =============================================================================
NEXT_PUBLIC_APP_NAME="Ecole SaaS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Sentry — browser + Next.js server-side error reporting (V1.5). Optional.
# Get a DSN from https://sentry.io → ecole-saas-web project. NEXT_PUBLIC_*
# exposes it to the client bundle (required so the browser can report errors).
NEXT_PUBLIC_SENTRY_DSN_WEB=""

# =============================================================================
# API (apps/api) — Vague 1
# =============================================================================
NODE_ENV="development"
API_PORT="4000"
CORS_ORIGIN="http://localhost:3000"

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecole_saas?schema=public"

# JWT secrets — generate locally via: openssl rand -base64 48
# MUST be at least 32 characters (>= 256 bits) — API refuses to start otherwise
JWT_ACCESS_SECRET="REPLACE_ME_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_VALUE"
JWT_REFRESH_SECRET="REPLACE_ME_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_VALUE"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Password hashing
BCRYPT_ROUNDS="12"

# Demo seed password (optional, >= 12 chars). If set, all demo accounts share it
# (stable, documented in docs/DEMO_CREDENTIALS.md). If unset, a random password is
# generated and printed at the end of `prisma db seed`.
DEMO_PASSWORD=""

# =============================================================================
# API (apps/api) — Vague 1.5
# =============================================================================
# Absolute URL of the web app — used to build invite/verify/reset links in emails
WEB_APP_URL="http://localhost:3000"

# Resend API key (https://resend.com — free tier 3000 emails/mo)
# Get one from the Resend dashboard, then add to Railway + GitHub Actions secrets
RESEND_API_KEY="re_REPLACE_ME"

# Sender address. Use `onboarding@resend.dev` until a custom domain is verified.
EMAIL_FROM="onboarding@resend.dev"

# Cloudflare R2 (RGPD data export storage — free tier, $0/mo).
# Provision a bucket + Account API Token (Object Read & Write).
# Leave empty in local dev — the API still boots, only /me/export will 503.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ecole-saas-exports"

# V1.6 — White-label tenant assets (logos, favicons).
# R2_PUBLIC_URL is the public base URL the browser will fetch logos from
# (e.g. https://pub-<hash>.r2.dev for dev, https://assets.ecole-saas.com
# once V11 lands the custom domain). TenantBrandService uses it to enforce
# that logoUrl/faviconUrl point to our bucket (anti-SSRF).
# Leave empty in local dev — branding API will refuse uploads (503).
R2_PUBLIC_URL=""
R2_TENANT_ASSETS_BUCKET="ecole-saas-tenant-assets"

# Sentry DSN for server-side error reporting (V1.5). Optional — without
# it the API still boots, just no error capture (see src/instrument.ts).
SENTRY_DSN_API=""

# =============================================================================
# Mobile (apps/mobile) — Vague 2
# =============================================================================
# EXPO_PUBLIC_API_URL="http://localhost:4000"

# =============================================================================
# Push notifications (Expo) — optional; API boots with push disabled if absent
# =============================================================================
EXPO_PUSH_ACCESS_TOKEN=""

# =============================================================================
# Bot protection (Cloudflare Turnstile) — optional
# =============================================================================
TURNSTILE_SECRET_KEY=""

# =============================================================================
# Payments — ClicToPay (Monétique Tunisie) — docs/payments/clictopay-integration.md
# Credentials provided by the bank after merchant onboarding. Test base URL below.
# Amounts in smallest unit (TND = millimes → Decimal × 1000), currency=788.
# =============================================================================
CLICTOPAY_BASE_URL="https://test.clictopay.com/rest"
CLICTOPAY_USER=""
CLICTOPAY_PWD=""

# =============================================================================
# SMS — Orange Tunisie (BulkSmsAPI). See docs/notifications/orange-sms.md.
# All optional; SMS channel is disabled (no-op) until bearer+email+password set.
# =============================================================================
ORANGE_SMS_BEARER_TOKEN=""
ORANGE_SMS_EMAIL=""
ORANGE_SMS_PASSWORD=""
ORANGE_SMS_HOST="inside.api.orange.tn"
ORANGE_SMS_UNITE_SEND_URL="/BulkSmsAPI/1.0/campaigns/basicApi/sendSms"
