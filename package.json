{
  "name": "ecole-saas",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de gestion d'école / jardin d'enfant — monorepo Turborepo",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "dev:mobile": "turbo run start --filter=@klasso/mobile",
    "type-check:mobile": "turbo run type-check --filter=@klasso/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@expo/vector-icons": "^15.0.3",
      "react-native-reanimated": "4.1.7",
      "react-native-worklets": "0.5.1",
      "@react-email/components>@types/react": "~18.3.0"
    }
  }
}
