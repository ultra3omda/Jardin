# Klasso monorepo — pnpm config
# 2026-06-03 (SDK 54 upgrade): switched from node-linker=hoisted to default
# (isolated). Hoisted caused @types/react@19 (mobile) to leak into web/api
# typecheck (which must stay on React 18 because of Next.js 14 + react-email).
# SDK 54 / Metro 0.81 supports pnpm symlinks via resolver config in
# apps/mobile/metro.config.js (disableHierarchicalLookup + nodeModulesPaths
# + unstable_enablePackageExports). See https://docs.expo.dev/guides/monorepos/

# Keep strict peer deps to catch issues early
strict-peer-dependencies=false
auto-install-peers=true

# Public-hoist everything to the workspace root so Metro can resolve Expo
# Router's many transitive runtime imports (@babel/runtime,
# @react-navigation/*, react-native-css-interop, …). Metro is configured with
# disableHierarchicalLookup=true and only searches
# [apps/mobile/node_modules, /repo/node_modules]; without hoisting it cannot
# follow pnpm's .pnpm/<hash>/ chain.
#
# Exclude @types/react and @types/react-dom from hoisting so the React 18
# workspaces (web, api with react-email) and the React 19 workspace (mobile)
# keep their isolated, per-workspace typings — that's the whole reason we
# moved off node-linker=hoisted in the SDK 54 upgrade.
public-hoist-pattern[]=*
public-hoist-pattern[]=!@types/react
public-hoist-pattern[]=!@types/react-dom
