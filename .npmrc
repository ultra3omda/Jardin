# Klasso monorepo — pnpm config
# 2026-06-03 (SDK 54 upgrade): switched from node-linker=hoisted to default
# (isolated). Hoisted caused @types/react@19 (mobile) to leak into web/api
# typecheck (which must stay on React 18 because of Next.js 14 + react-email).
# SDK 54 / Metro 0.81 supports pnpm symlinks via resolver config in
# apps/mobile/metro.config.js (disableHierarchicalLookup + nodeModulesPaths
# + unstable_enablePackageExports). See https://docs.expo.dev/guides/monorepos/

# Keep strict peer deps to catch issues early
strict-peer-dependencies=false
auto-install-peers=true
