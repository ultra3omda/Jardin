# Klasso monorepo — pnpm config
# V1.7-A2 (2026-05-24) : node-linker=hoisted required for Expo SDK 51 + Metro
# bundler in monorepo. See https://docs.expo.dev/guides/monorepos/#pnpm-workspaces
# Without this, Metro cannot resolve @babel/runtime/* and other transitive deps
# through pnpm's symlinked .pnpm store.
#
# Side effects on other apps (verified non-breaking 2026-05-24) :
# - apps/web (Next.js 14): handled by next own bundler, unaffected
# - apps/api (NestJS 10): uses tsc/swc, unaffected
node-linker=hoisted

# Keep strict peer deps to catch issues early
strict-peer-dependencies=false
auto-install-peers=true
