{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^build", "^type-check"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "@klasso/mobile#start": {
      "cache": false,
      "persistent": true
    },
    "@klasso/mobile#type-check": {
      "dependsOn": ["^build", "^type-check"],
      "outputs": []
    },
    "@klasso/mobile#lint": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
